# ===========================================
# FRONTEND - Variables d'environnement
# ===========================================
# Copier ce fichier en .env.local pour le développement
# Ou configurer ces variables dans Vercel pour la production

# URL de l'API Backend
# - Développement: http://localhost:3001
# - Production Vercel: Utiliser la variable BACKEND_URL pour le rewrite
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL du site (pour les métadonnées SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# VERCEL - Variables à configurer dans le dashboard
# ===========================================
# BACKEND_URL=https://votre-backend.railway.app
