# Configuration de production - À COPIER sur le serveur et renommer en .env.production.local
# NE PAS VERSIONNER CE FICHIER AVEC LES VRAIES VALEURS

# URLs pour la configuration
NEXT_PUBLIC_API_URL=https://darkei-elyahou.org/api
NEXT_PUBLIC_SITE_URL=https://darkei-elyahou.org
FRONTEND_URL=https://darkei-elyahou.org

# Configuration de session (OBLIGATOIRE - minimum 32 caractères)
# Générez une clé sécurisée avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=REMPLACEZ_PAR_UNE_CLE_SECURISEE_DE_MINIMUM_64_CARACTERES_GENEREE

# Configuration Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=REMPLACER_SI_NECESSAIRE

# Configuration des emails
NEXT_PUBLIC_RESEND_FROM_EMAIL=contact@darkei-elyahou.org
RESEND_API_KEY=VOTRE_API_KEY_RESEND
DEFAULT_FROM_EMAIL=contact@darkei-elyahou.org
ADMIN_EMAIL=admin@darkei-elyahou.org

# Configuration de la base de données
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/nom_bdd?schema=public"

# CORS et sécurité
ALLOWED_ORIGINS=https://darkei-elyahou.org,https://www.darkei-elyahou.org

# Autres configurations
PORT=3001
NODE_ENV=production
