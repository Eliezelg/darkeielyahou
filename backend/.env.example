# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/darkei_elyahou?schema=public"

# Configuration de session
SESSION_SECRET="une_longue_chaine_aleatoire_secrete_a_changer"

# Configuration admin (optionnel, pour compatibilité)
ADMIN_PASSWORD="votre_mot_de_passe_admin"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# SendGrid API (pour les emails)
SENDGRID_API_KEY="votre_cle_sendgrid"

# Origines autorisées pour CORS
ALLOWED_ORIGINS="http://localhost:3000"

# Redis URL (optionnel)
REDIS_URL="redis://localhost:6379"

# JWT Secret (optionnel, utilise SESSION_SECRET par défaut)
JWT_SECRET="votre_secret_jwt"