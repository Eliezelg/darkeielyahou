# ===========================================
# BACKEND - Variables d'environnement
# ===========================================
# Copier ce fichier en .env pour le développement local
# Pour Railway: configurer ces variables dans le dashboard

# ===========================================
# BASE DE DONNÉES (PostgreSQL)
# ===========================================
# Railway fournit automatiquement DATABASE_URL quand vous ajoutez PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/darkei_elyahou?schema=public"

# Port du serveur (Railway définit automatiquement PORT)
PORT=3001

# Configuration de session (OBLIGATOIRE - minimum 32 caractères)
# Générez une clé sécurisée avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET="REMPLACEZ_PAR_UNE_CLE_SECURISEE_DE_MINIMUM_32_CARACTERES"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# SendGrid API (pour les emails)
SENDGRID_API_KEY="votre_cle_sendgrid"

# Resend API (alternative à SendGrid)
RESEND_API_KEY="votre_cle_resend"

# Email par défaut pour l'envoi
DEFAULT_FROM_EMAIL="contact@darkei-elyahou.org"

# Email admin pour recevoir les copies
ADMIN_EMAIL="admin@darkei-elyahou.org"

# Origines autorisées pour CORS
ALLOWED_ORIGINS="http://localhost:3000"

# Redis URL (optionnel mais recommandé en production)
REDIS_URL="redis://localhost:6379"

# Environnement
NODE_ENV="development"